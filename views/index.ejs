              </div>
              <div class="member-info">
                  <h3> </h3>
                  <div class="member-meta">
                      <span><i class="fas fa-user-tie"></i> Jefatura de Personal</span>
                      <span><i class="fas fa-discord"></i> </span>
                  </div>
                  <p> </p>
              </div>
