              <ul>
                <li>Exclusivos neones rojos y dorados.</li>
                <li>Letrero al entrar, "<strong>The Palace</strong>".</li>
                <li>Estacionamiento exclusivo para clientes.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- Sección de Miembros -->
