              <h3>THE PALACE</h3>
              <p>Fachada principal</p>
          </div>
        </div>
        <div class="gallery-item">
          <img src="/images/exterior.png" alt="Edificio The Palace">
          <div class="gallery-overlay">
              <h3>THE PALACE</h3>
              <p>Por dentro</p>
          </div>
        </div>
        <div class="location-info">
          <h3><i class="fas fa-crosshairs"></i> Cómo encontrarnos</h3>
          <div class="location-detail">
            <i class="fas fa-map-pin"></i>
            <div>
              <h4>Dirección</h4>
              <p>Clinton Avenue esquina Power Street<br>Centro de Vinewood, Los Santos</p>
