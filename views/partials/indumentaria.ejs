                                <li>Pantalón cargo resistente</li>
                                <li>Guantes opcionales</li>
                                <li>Comunicador visible</li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/security-male-formal.jpg" alt="Seguridad Masculino Eventos">
                            <div class="attire-badge">EVENTOS</div>
                        </div>
                        <div class="attire-info">
                            <h3>SEGURIDAD</h3>
                            <ul class="uniform-features">
                                <li>Traje negro premium</li>
                                <li>Camisa blanca impecable</li>
                                <li>Zapatos de vestir negros</li>
                                <li>Gafas de sol permitidas</li>
                            </ul>
