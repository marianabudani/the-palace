<section id="attire" class="section dark-section">
    <div class="section-content">
        <h2 class="section-title">ESTILO PALACE</h2>
        
        <div class="attire-tabs">
            <button class="attire-tab active" data-tab="staff">STAFF</button>
            <button class="attire-tab" data-tab="security">SEGURIDAD</button>
        </div>

        <!-- Selector de género -->
        <div class="gender-selector">
            <button class="gender-btn active" data-gender="male">Masculino</button>
            <button class="gender-btn" data-gender="female">Femenino</button>
        </div>
  
        <!-- Contenido STAFF -->
        <div class="attire-content active" id="staff-tab">
            <div class="members-grid">
                <!-- Bartender Masculino -->
                <div class="uniform-pair" data-gender="male">
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/bartender-male-daily.jpg" alt="Bartender Masculino Diario">
                            <div class="member-badge">UNIFORME</div>
                        </div>
                        <div class="member-info">
                            <h3>BARTENDER</h3>
                            <ul class="uniform-features">
                                <li>Chaleco de cuero opcional</li>
                                <li>Zapatos negros formales</li>
                                <li>Accesorios permitidos</li>
                                <li>Look elegante y profesional</li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/bartender-male-formal.jpg" alt="Bartender Masculino Eventos">
                            <div class="attire-badge">EVENTOS</div>
                        </div>
                        <div class="attire-info">
                            <h3>BARTENDER</h3>
                            <ul class="uniform-features">
                                <li>Corbata roja de seda</li>
                                <li>Zapatos de vestir italianos</li>
                                <li>Reloj elegante permitido</li>
                                <li>Perfume discreto</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <!-- Bartender Femenino -->
                <div class="uniform-pair" data-gender="female">
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/uniforme-bartender.png" alt="Bartender Femenino Diario">
                            <div class="attire-badge">UNIFORME</div>
                        </div>
                        <div class="attire-info">
                            <h3>BARTENDER</h3>
                            <ul class="uniform-features">
                                <li>Pantalón negro ajustado</li>
                                <li>Maquillaje y accesorios opcionales</li>
                                <li>Zapatillas negras cómodas</li>
                                <li>Look moderno y funcional</li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/uniforme-eventos.png" alt="Bartender Femenino Eventos">
                            <div class="attire-badge">EVENTOS</div>
                        </div>
                        <div class="attire-info">
                            <h3>BARTENDER</h3>
                            <ul class="uniform-features">
                                <li>Vestido rojo, elegante y cómodo</li>
                                <li>Zapatos de tacón alto</li>
                                <li>Maquillaje rojo/negro opcional</li>
                                <li>Peinado y Accesorios a gusto del empleado</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
  
        <!-- Contenido SEGURIDAD -->
        <div class="attire-content" id="security-tab">
            <div class="attire-grid">
                <!-- Seguridad Masculino -->
                <div class="uniform-pair" data-gender="male">
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/security-male-daily.jpg" alt="Seguridad Masculino Diario">
                            <div class="attire-badge">UNIFORME</div>
                        </div>
                        <div class="attire-info">
                            <h3>SEGURIDAD</h3>
                            <ul class="uniform-features">
