                            <div class="attire-badge">UNIFORME</div>
                        </div>
                        <div class="attire-info">
                            <h3>SEGURIDAD</h3>
                            <ul class="uniform-features">
                                <li>Camisa roja</li>
                                <li>Pantalón cargo elástico</li>
                                <li>Chaleco de seguridad</li>
                                <li>Radio visible</li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="attire-card">
                        <div class="attire-image">
                            <img src="/images/uniforme/security-female-formal.jpg" alt="Seguridad Femenino Eventos">
                            <div class="attire-badge">EVENTOS</div>
                        </div>
                        <div class="attire-info">
                            <h3>SEGURIDAD</h3>
                            <ul class="uniform-features">
                                <li>Traje pantalón negro</li>
                                <li>Blusa blanca elegante</li>
                                <li>Zapatos de tacón bajo</li>
                                <li>Maquillaje discreto</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>